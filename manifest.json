{
  "manifest_version": 3,
  "name": "YouTube Auto Skip",
  "version": "1.8.2",
  "description": "Skip YouTube ads automatically or block known ad requests.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "skip.js"
      ]
    }
  ],
  "permissions": [
    "debugger",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "notifications"
  ],
  "background": {
    "service_worker": "input.js"
  },
  "icons": {
    "16": "icons/youtube-16.png",
    "32": "icons/youtube-32.png",
    "48": "icons/youtube-48.png",
    "128": "icons/youtube-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/youtube-16.png",
      "32": "icons/youtube-32.png",
      "48": "icons/youtube-48.png",
      "128": "icons/youtube-128.png"
    },
    "default_title": "YouTube Auto Skip",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ads",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}
