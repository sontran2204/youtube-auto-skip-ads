{
  "manifest_version": 3,
  "name": "YouTube Auto Skip",
  "version": "1.4.1",
  "description": "Clicks the Skip button when it becomes available on a YouTube video ad.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "skip.js"
      ]
    }
  ],
  "permissions": [
    "debugger"
  ],
  "background": {
    "service_worker": "input.js"
  },
  "icons": {
    "16": "icons/youtube-16.png",
    "32": "icons/youtube-32.png",
    "48": "icons/youtube-48.png",
    "128": "icons/youtube-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/youtube-16.png",
      "32": "icons/youtube-32.png",
      "48": "icons/youtube-48.png",
      "128": "icons/youtube-128.png"
    },
    "default_title": "YouTube Auto Skip"
  }
}
